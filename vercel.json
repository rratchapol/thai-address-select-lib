{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run docs:build",
  "outputDirectory": "docs-dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/index.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        {
          "key": "Link",
          "value": "<https://www.thai-address-select-lib.taotech.site/>; rel=\"canonical\", <https://www.thai-address-select-lib.taotech.site/llms.txt>; rel=\"describedby\""
        }
      ]
    }
  ]
}
